# Apache config — block access to internal directories and dotfiles.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to /storage, /db, /src, /config, /bin from the web
    RewriteRule ^(storage|db|src|config|bin|tests)/?(.*)$ - [F,L]

    # Block dotfiles (.env, .git, etc)
    RewriteCond %{REQUEST_URI} (^|/)\.
    RewriteRule . - [F,L]

    # Friendly /sitemap.xml -> /public/sitemap.php
    RewriteRule ^sitemap\.xml$ public/sitemap.php [L]
    RewriteRule ^public/sitemap\.xml$ public/sitemap.php [L]
</IfModule>

# Sensible defaults
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# UTF-8
AddDefaultCharset UTF-8

# PWA MIME types
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg

# Custom error pages
ErrorDocument 404 /public/404.html
ErrorDocument 500 /public/500.html
ErrorDocument 503 /public/500.html

# Disable directory listing
Options -Indexes
