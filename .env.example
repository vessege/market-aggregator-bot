# ===== App =====
APP_ENV=production
APP_URL=https://example.com
APP_TIMEZONE=Asia/Tashkent

# ===== Database =====
# Drayverlar: mysql | sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=market_bot
DB_USER=market_bot
DB_PASS=

# SQLite uchun (DB_DRIVER=sqlite bo'lsa)
DB_SQLITE_PATH=storage/database.sqlite

# ===== Admin (birinchi superadmin) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ===== Parsers =====
PARSER_USER_AGENT=Mozilla/5.0 (compatible; MarketCompare/1.0)
PARSER_REQUEST_DELAY_MS=800
PARSER_TIMEOUT=20
# Transient error retry behaviour (5xx / network / 429)
PARSER_RETRIES=2
PARSER_BACKOFF_MS=400

# Uzum live search (GraphQL) — ixtiyoriy. Token uzum.uz frontend'idan olinadi
# (Network tab -> Authorization header). Token muddati cheklangan, vaqti-vaqti
# bilan yangilab turish kerak. Bo'sh bo'lsa Uzum live search ishlamaydi.
UZUM_AUTH_TOKEN=
UZUM_AUTH_TYPE=Bearer
UZUM_X_IID=
UZUM_GRAPHQL_URL=https://graphql.uzum.uz/

# ===== API rate limiting (per IP, per 60s window) =====
# 0 disables the limit; the live limit gates the outbound marketplace hop
# inside /api/?action=products and the live refresh inside /api/?action=product.
RATE_LIMIT_API_RPM=60
RATE_LIMIT_LIVE_RPM=10

# ===== Currency conversion (display all prices in UZS) =====
# Approximate rates from source currency → UZS. Override per environment.
# These can also be set in the `settings` table (key=fx_rub_to_uzs etc.).
FX_RUB_TO_UZS=160
FX_USD_TO_UZS=12700
FX_EUR_TO_UZS=13800
FX_KZT_TO_UZS=27

# ===== Sessions / security =====
SESSION_NAME=mab_session
APP_KEY=change-me-to-random-32-char-string

# ===== Backups / SEO / alerts =====
# How many days of daily DB backups to keep in storage/backups/ before pruning.
BACKUP_KEEP_DAYS=14

# Public canonical URL of the site (used by sitemap + alert emails).
# Leave empty to auto-derive from the current request.
PUBLIC_URL=

# From: header for outbound emails (price-drop alerts).
MAIL_FROM=no-reply@example.com
