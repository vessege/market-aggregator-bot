# ===== App =====
APP_ENV=production
APP_URL=https://example.com
APP_TIMEZONE=Asia/Tashkent

# ===== Telegram =====
# BotFather'dan oling
BOT_TOKEN=
# Botning username'i (without @), masalan: my_market_bot
BOT_USERNAME=
# WebApp ochiladigan to'liq HTTPS URL (Telegram talabi)
WEBAPP_URL=https://example.com/public/
# Webhook URL (POST qabul qilinadigan ochiq endpoint)
WEBHOOK_URL=https://example.com/webhook.php
# Webhook secret token (Telegram setWebhook secret_token)
WEBHOOK_SECRET=change-me-to-random-string

# ===== Database =====
# Drayverlar: mysql | sqlite
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=market_bot
DB_USER=market_bot
DB_PASS=

# SQLite uchun (DB_DRIVER=sqlite bo'lsa)
DB_SQLITE_PATH=storage/database.sqlite

# ===== Admin (birinchi superadmin) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Bot orqali ham admin huquqi beradigan Telegram user IDlar (vergul bilan)
ADMIN_TELEGRAM_IDS=

# ===== Parsers =====
PARSER_USER_AGENT=Mozilla/5.0 (compatible; MarketAggregatorBot/1.0)
PARSER_REQUEST_DELAY_MS=800
PARSER_TIMEOUT=20

# Uzum live search (GraphQL) — ixtiyoriy. Token uzum.uz frontend'idan olinadi
# (Network tab -> Authorization header). Token muddati cheklangan, vaqti-vaqti
# bilan yangilab turish kerak. Bo'sh bo'lsa Uzum live search ishlamaydi.
UZUM_AUTH_TOKEN=
UZUM_AUTH_TYPE=Bearer
UZUM_X_IID=
UZUM_GRAPHQL_URL=https://graphql.uzum.uz/

# ===== Sessions / security =====
SESSION_NAME=mab_session
APP_KEY=change-me-to-random-32-char-string
