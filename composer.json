{
    "name": "vessege/market-aggregator-bot",
    "description": "Telegram WebApp marketplace aggregator (PHP + MySQL/SQLite + vanilla JS) with admin panel, broadcast and forced subscription",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "MarketBot\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
        "setup": "php bin/setup.php",
        "test": "php tests/run.php"
    }
}
